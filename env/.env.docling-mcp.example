# Template for .env.docling-mcp. Copy to .env.docling-mcp and fill in the values. Never commit the filled-in file.
# Settings for the docling-mcp container (loaded after the root .env).

# Keycloak JWT checks for the MCP endpoint (same values as agent-service).
MCP_JWKS_URL=
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=
OIDC_ISSUER=
APP_PUBLIC_URL=

# Document conversion (the docling container on the backend network).
DOCLING_API_URL=http://docling:5001
DOCLING_TIMEOUT_SECONDS=300

# Chat events go through the line service (it holds the Open WebUI key).
# INTERNAL_API_TOKEN must equal the value in services/line/env/.env.line.
INTERNAL_API_TOKEN=

# Extracted images (extract_images=true). The caller picks the destination per call:
# open_terminal_path given -> Open Terminal; omitted -> Open WebUI file store.
# Open Terminal (used when the tool input gives open_terminal_path). Multi-user mode: each upload goes to
# the caller's workspace (X-User-Id from open-webui's forwarded headers).
OPEN_TERMINAL_URL=http://open-terminal:8000
OPEN_TERMINAL_API_KEY=
# Open WebUI file store. Each user's key is entered with the docling_set_open_webui_key tool (secure form)
# and stored encrypted in the agent database, so uploads belong to the caller. No key goes in this file.
OPEN_WEBUI_URL=http://open-webui:8080

# Encrypted per-user secrets (service_secrets table). Use the same values as agent-service.
AGENT_DATABASE_URL=
SECRETS_ENCRYPTION_KEY=
